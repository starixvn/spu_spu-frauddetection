@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewResources.Offline</title>
    <style type="text/css">
        html, body
        {
            border: 0;
            margin: 0;
            outline: 0;
            padding: 0;
        }

        body
        {
            color: #333;
            font-family: 'Segoe UI' , Tahoma, Arial, Sans-Serif;
        }

        .container
        {
            background-color: #549cba;
            margin: 0 auto;
            padding: 20px;
            width: 960px;
        }

        h1
        {
            border-bottom: solid 1px #fff;
            color: #fff;
            font-weight: normal;
            padding: 0 0 10px;
        }

        a
        {
            color: #fff;
            text-decoration: none;
        }

        a:hover
        {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>
            @ViewResources.Maintenance</h1>
        <p>
            Special Delete is currently unavailable due to scheduled maintenance.<br />
            This downtime will last from <span class="em">@(ViewBag.UmtFrom)</span> &rarr; <span
                class="em">@(ViewBag.UmtTo)</span> (GMT+8). Thanks for your patience!
        </p>
    </div>
</body>
</html>