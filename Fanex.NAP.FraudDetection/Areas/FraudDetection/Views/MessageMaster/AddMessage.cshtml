@model FD.Lib.DTO.MessageMaster
@{
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
    ViewBag.Title = "Add Message";
}

@section FooterJs
{
    @Scripts.Render("~/bundles/TagItJs")
    @Scripts.Render("~/bundles/App/AddMessageMaster")
}
@using (Html.BeginForm("Add", "MessageMaster", FormMethod.Post, new { @id = "addNewMesssageForm" }))
{
    <div class="col-sm-12 form-edit">
        <div class="col-sm-9">
            <div class="col-sm-12">
                <div class="col-sm-3">
                    <label>
                        Message Code
                    </label>
                </div>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.MessageCode, new { @class = "col-sm-9 inputbox ui-corner-all", @style = "" })
                    @Html.ValidationMessageFor(model => model.MessageCode)
                    <div class="col-sm-3">
                        <label>
                            Active
                        </label>
                        @Html.CheckBoxFor(model => model.IsActive, new { @checked = "checked" })
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="col-sm-3">
                    <label>
                        Description
                    </label>
                </div>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.MessageDesc, new { @class = "col-sm-11 inputbox ui-corner-all" })
                </div>
            </div>
            <div class="col-sm-12">
                <label class="col-sm-3">
                    Content
                </label>
                <div class="col-sm-9">
                    @Html.TextArea("displayContent", new { @class = "col-sm-11 inputbox ui-corner-all textarea", @id = "displayContent" })
                    @Html.HiddenFor(model => model.MessageContent, new { @id = "content" })
                </div>
            </div>
            <div class="col-sm-12">
                <div class="col-sm-3">
                    <label>
                        Recipient
                    </label>
                    <img src="~/Areas/FraudDetection/App_Themes/Images/icon-question.PNG" class="question-icon"
                         title="Those who will receive the message even they are online or offline" />
                </div>
                <div class="col-sm-9">
                    <ul id="RecipientTags" class="col-sm-11"></ul>
                    @Html.TextBoxFor(model => model.UsernameRecipient, new { @id = "fakeRecipientTags", @class = "inputbox col-sm-11 ui-corner-all textarea" })
                    @Html.HiddenFor(model => model.Recipient)
                </div>
            </div>
            <div class="col-sm-12">
                <div class="col-sm-3">
                    <label>
                        Online Recipient
                    </label>
                    <img src="~/Areas/FraudDetection/App_Themes/Images/icon-question.PNG" class="question-icon"
                         title="Those who will receive the message only when they are online" />
                </div>
                <div class="col-sm-9">
                    <ul id="OnlRecipientTags" class="col-sm-11"></ul>
                    @Html.TextBoxFor(model => model.UsernameOnlineRecipient, new { @id = "fakeOnlRecipientTags", @class = "inputbox col-sm-11 ui-corner-all" })
                    @Html.HiddenFor(model => model.OnlineRecipient)
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="paramerter">
                <div onclick="insertParameters('TeamAvsTeamB');" class="message-parameter list-group-item">
                    Team A vs team B
                </div>
                <div onclick="insertParameters('MatchCode');" class="message-parameter list-group-item">
                    Match code
                </div>
                <div onclick="insertParameters('MatchId');" class="message-parameter list-group-item">
                    Match Id
                </div>
                <div onclick="insertParameters('FraudCaseName');" class="message-parameter list-group-item">
                    Fraud case name
                </div>
            </div>
        </div>
    </div>

    <div class="form-group text-center col-md-12">
        <input id="btn_addMessage" type="button" value="Submit" class="btn-green" />
        <input id="btn_cancelMessage" type="button" value="Cancel" class="btn-green" />
    </div>
}