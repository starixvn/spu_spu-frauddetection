@using Fanex.NAP.FraudDetection.Service.Core
@using Fanex.NAP.FraudDetection.Service.Utilities
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Message Master";
}

@section HeadCss
{
    @*<link href="@Url.Content("~/Areas/FraudDetection/Content/mailmaster.css")" rel="stylesheet" type="text/css" />*@
}
@section FooterJs
{
    <script type="text/javascript">
        var isHost = "@PermissionService.HasHostPermission(FDFunctionKeys.MailMaster)" === "True";
    </script>
    @Scripts.Render("~/bundles/App/MessageMaster")

}
<div>
    <span class="infor-text">All Messages</span>
    @if (PermissionService.HasHostPermission(FDFunctionKeys.MailMaster))
    {
        <input class="btn-green" type="button" value="+ Add Mail"
               onclick="location.href='@Url.Action("Add", "MessageMaster")'" />
    }
</div>
<div id="mailSearch" class="newline">
    &nbsp;
</div>
<div id="messageMasterId" class="freegrid content-grid">
</div>
