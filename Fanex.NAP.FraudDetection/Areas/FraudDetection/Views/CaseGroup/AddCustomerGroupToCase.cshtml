@{
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
    ViewBag.Title = "Add Customer Group To Case";
}

@model Fanex.NAP.FraudDetection.Areas.FraudDetection.Models.AddCustomerGroupToCaseViewModel

<div>
    <div id="AvailableGroups" class="freegrid  content-grid"></div>
    <div class="newline" style="clear: both;">&nbsp;</div>
    <div class="text-center">
        <input type="button" id="btn_addGroup" value="Submit" class="btn-green font-size-small" />
        <input type="button" id="btn_Cancel" value="Cancel" class="btn-green btn-customCancel font-size-small" />
    </div>
</div>

@section FooterJs
{
    <script type="text/javascript">
        var caseId = @Model.CaseId;
        var groups = @Html.Raw(Json.Encode(Model.Groups));
    </script>
    @*<script src="~/Areas/FraudDetection/Scripts/CaseGroup/spuApp.js"></script>
    <script src="~/Areas/FraudDetection/Scripts/CaseGroup/caseGroupService.js"></script>*@
    <script src="~/Areas/FraudDetection/Scripts/CaseGroup/caseGroupController.js"></script>
}