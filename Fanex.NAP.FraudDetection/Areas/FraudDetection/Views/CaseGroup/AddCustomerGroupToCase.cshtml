@{
    Layout = "~/Views/Shared/_LayoutPopup2.cshtml";
    ViewBag.Title = "Add Customer Group To Case";
}

@model Fanex.NAP.FraudDetection.Areas.FraudDetection.Models.AddCustomerGroupToCaseViewModel

@section HeadCss
{
}

<div ng-controller="CaseGroupController">
    <div style="max-height: 230px; overflow-y: scroll;">
        <table st-table="rowCollection" class="table table-striped table-bordered">
            <thead>
            <tr>
                <th>#</th>
                <th><input type="checkbox" ng-checked="isSelectAll" ng-click="selectAll()"/></th>
                <th class="text-left">Group Name</th>
                <th class="text-left">Group Description</th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat="row in rowCollection">
                <td class="text-center">{{$index + 1}}</td>
                <td class="text-center"><input type="checkbox" ng-checked="row.isSelected" ng-click="selectRow($index)"/></td>
                <td>{{row.GroupName}}</td>
                <td>{{row.GroupDesc}}</td>
            </tr>
            </tbody>
        </table>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <input type="button" class="btn btn-green" value="Add To Case" ng-click="submitData()"/>
</div>

@section FooterJs
{
    <script type="text/javascript">
        var caseId = @Model.CaseId;
        var groups = @Html.Raw(Json.Encode(Model.Groups));
    </script>
    <script src="~/Areas/FraudDetection/Scripts/CaseGroup/spuApp.js"></script>
    <script src="~/Areas/FraudDetection/Scripts/CaseGroup/caseGroupService.js"></script>
    <script src="~/Areas/FraudDetection/Scripts/CaseGroup/caseGroupController.js"></script>
}