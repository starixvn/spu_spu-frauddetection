@model SPU.Lib.FraudDetection.Criteria.Case.CaseInsertCriteria
@{
    ViewBag.Title = "Add New Case";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
    Model.IsActive = true;
}

@using (Html.BeginForm("AddNewCase", "Case", FormMethod.Post, new { @id = "AddCaseForm" }))
{
    <table class="table-popup">
        <tr>
            <td align="right"><span>Case Name</span></td>
            <td>@Html.TextBoxFor(l => l.CaseName, new { @style = "width: 330px;" })</td>
        </tr>
        <tr>
            <td align="right"><span>Description</span></td>
            <td>@Html.TextAreaFor(l => l.CaseDesc, 5, 45, new { @style = "width: 330px;" })</td>
        </tr>
        <tr>
            <td align="right"><span>Active</span></td>
            <td>@Html.CheckBoxFor(l => l.IsActive)</td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="button" id="btn_addCase" value="Submit" class="btn-green font-size-small" />
                <input type="button" id="btn_Cancel" value="Cancel" class="btn-green btn-customCancel font-size-small" />
            </td>
        </tr>
    </table>
}

@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/Case/case-add.js" type="text/javascript"></script>
}
