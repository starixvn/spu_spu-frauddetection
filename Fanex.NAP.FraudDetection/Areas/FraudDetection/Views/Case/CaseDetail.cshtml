@model SPU.Lib.FraudDetection.Criteria.Task.TaskSelectAllByCaseIdCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Case Details";
}
@section HeadCss
{
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridCss")" />
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />
}

@section FooterJs
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/Case/case-detail-list.js" type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/Case/case-detail-edit.js" type="text/javascript"></script>
}

<div>
    @Html.HiddenFor(a => a.CaseId)
    <span class="infor-text">Case Details </span>
    <div class="button-action">
        <a class="back-button" href="/Case">← Back To List </a>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <span class="lbl-text">Case Name: @ViewBag.CaseName </span>
    <input type="button" id="btn_AddNewTask" value="+ Add Task" class="btn-green" />
</div>
<div class="newline">&nbsp;</div>
<div class="grid-container">
    <div id="SearchResult" class="freegrid  content-grid">&nbsp;</div>
</div>
<div class="newline" style="clear: both;">&nbsp;</div>
<div class="grid-container">
    <div id="CaseGroupResult" class="freegrid  content-grid">&nbsp;</div>
</div>

