@model FD.Lib.Criteria.Task.TaskGetAllByCaseIdCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Case Details";
}
@section HeadCss
{
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/Content/case.css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/Case")
    <script src="~/Areas/FraudDetection/Scripts/Case/case-detail-list.js" type="text/javascript"></script>
}
<div>
    @Html.HiddenFor(a => a.CaseId)

    <span class="infor-text">Case Details </span>
    <span class="button-action">
        <a class="back-button" onclick="window.location.href = window.location.href.split('/GetCaseDetail', 1)[0].toString();">← Back To List </a>
    </span>

    <div class="newline">
        &nbsp;
    </div>
    <span class="lbl-text">Case Name: @ViewBag.CaseName </span>
    <input type="button" id="btn_AddNewTask" value="+ Add Task" class="btn-green" />
</div>
<div class="newline">
    &nbsp;
</div>
<div class="grid-container">
    <div id="SearchResult" class="freegrid  content-grid">
        &nbsp;
    </div>
</div>
<div class="newline" style="clear: both;">
    &nbsp;
</div>
<div class="grid-container">
    <div id="CaseGroupResult" class="freegrid  content-grid">
        &nbsp;
    </div>
</div>
