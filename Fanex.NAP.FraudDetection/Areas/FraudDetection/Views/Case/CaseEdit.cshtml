@using System.Web.UI.WebControls
@model Fanex.NAP.FraudDetection.Model.Case.CaseUpdateModel
@{
    ViewBag.Title = "Edit Case";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";

    var listItems = new List<ListItem>();
    foreach (var item in Model.CaseTypes)
    {
        var listItem = new ListItem
        {
            Text = item.TypeName,
            Value = item.TypeId.ToString(),
            Selected = item.TypeId == Model.CaseModel.TypeId
        };

        listItems.Add(listItem);
    }
}
@using (Html.BeginForm("EditCaseInfo", "Case", FormMethod.Post, new { @id = "EditCaseForm" }))
{
    <table class="table-popup">
        <tr>
            <td align="right">
                <span>Case Name</span>
            </td>
            <td>
                @Html.TextBoxFor(l => l.CaseModel.CaseName, new { @style = "width: 330px;" })
            </td>
        </tr>
        <tr>
            <td align="right">
                <span>Description</span>
            </td>
            <td>
                @Html.TextAreaFor(l => l.CaseModel.CaseDesc, 5, 45, new { @style = "width: 330px;" })
            </td>
        </tr>
        <tr>
            <td align="right"><span>Type</span></td>
            <td>@Html.DropDownListFor(l => l.CaseModel.TypeId, new SelectList(listItems, "Value", "Text"), new { @style = "width: 330px;" })</td>
        </tr>
        <tr>
            <td align="right">
                <span>Active</span>
            </td>
            <td>
                @Html.CheckBoxFor(l => l.CaseModel.IsActive)
            </td>
        </tr>
        <tr>
            <td align="right">
                <span>Internal</span>
            </td>
            <td>
                @Html.CheckBoxFor(l => l.CaseModel.IsInternal)
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="button" id="btn_editCase" value="Submit" class="btn-green font-size-small" />
                <input type="button" id="btn_Cancel" value="Cancel" class="btn-green btn-customCancel font-size-small" />
            </td>
        </tr>
    </table>
    @Html.HiddenFor(l => l.CaseModel.CaseId)
}
@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/Case/case-edit.js" type="text/javascript"></script>
}
