@model SPU.Lib.FraudDetection.Criteria.Case.CaseUpdateCriteria
@{
    ViewBag.Title = "Edit Case";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using (Html.BeginForm("EditCase", "Case", FormMethod.Post, new { @id = "EditCaseForm" }))
{
    <table class="table-popup">
        <tr>
            <td align="right">
                <span>Case Name</span>
            </td>
            <td>@Html.TextBoxFor(l => l.CaseName, new { @style = "width: 330px;" })
            </td>
        </tr>
        <tr>
            <td align="right">
                <span>Description</span>
            </td>
            <td>@Html.TextAreaFor(l => l.CaseDesc, 5, 45, new { @style = "width: 330px;" })
            </td>
        </tr>
        <tr>
            <td align="right">
                <span>Active</span>
            </td>
            <td>@Html.CheckBoxFor(l => l.IsActive)
            </td>
        </tr>
        <tr>
            <td>
            </td>
            <td>
                <input type="button" id="btn_editCase" value="Submit" class="btn-green font-size-small" />
                <input type="button" id="btn_Cancel" value="Cancel" class="btn-green btn-customCancel font-size-small" />
            </td>
        </tr>
    </table>
    @Html.HiddenFor(l => l.CaseId)
}

@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/Case/case-edit.js" type="text/javascript"></script>
}
