@using Fanex.NAP.FraudDetection.Service.Core
@using Fanex.NAP.FraudDetection.Service.Utilities
@model FD.Lib.Criteria.Case.CaseGetAllCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "All Fraud Cases";
}

@section FooterJs
{
    @Scripts.Render("~/bundles/App/Case")
    <script type="text/javascript">
        var isHost = "@PermissionService.HasHostPermission(FDFunctionKeys.FraudCase)" === "True";
        var isTest = "@ViewBag.IsTest" === "True";
    </script>
    <script src="~/Areas/FraudDetection/Scripts/Case/case-list.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">@ViewBag.Title</span>
    @if (PermissionService.HasHostPermission(FDFunctionKeys.FraudCase))
    {
        <input type="button" id="btn_addNewCase" value="+ Add Case" class="btn-green" />
    }
</div>
<div class="newline">
    &nbsp;
</div>
<form id="myForm" method="get" action="">
    <div class="formSearch">
        @Html.HiddenFor(s => s.PageSize)
        @Html.HiddenFor(s => s.PageIndex)
        @Html.HiddenFor(s => s.PageCount)
    </div>
</form>
<div id="SearchResult" class="freegrid  content-grid">
</div>
