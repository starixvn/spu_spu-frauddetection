@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Details";

}
@section HeadCss
{
    @Styles.Render("~/Content/betlist/FanexBetListCss")
    <link href="~/Areas/FraudDetection/Content/suspiciouscustomerdetailreport.css" rel="stylesheet"
        type="text/css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/CustomerDetailsReport")
}
<div ng-controller="customerDetailsReportController as cdrCtrl">
    <div>
        <span class="infor-text">@ViewBag.Title
            @*<a class="back-button" ng-click="cdrCtrl.goBack()">← Back To List </a>*@ </span>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div class="form-inline col-sm-12 filter-forml">
        <div class="col-sm-12" style="display: inline-block; vertical-align: middle; text-align: center;
            font-weight: bold;">
            <span style="padding-right: 50px;">Customer: {{ cdrCtrl.CustInfo.UserName }} ({{ cdrCtrl.CustInfo.CurrencyCode
                }}) </span><span>Date Range: {{ cdrCtrl.GeneralInfo.FromDate }} ~ {{ cdrCtrl.GeneralInfo.ToDate
                    }} </span>
        </div>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div>
        <label>
            Follow Up Detail</label>
        <div class="suspicious-customer-follow-up-detail" style="margin-left: 10px;">
            <table class=" col-sm-12">
                @*<tr>
                    <td valign="top">
                        Assignees
                    </td>
                    <td>
                        Tracy
                    </td>
                </tr>*@
                <tr>
                    <td valign="top">
                        Fraud Case
                    </td>
                    <td>
                        <div class="freegrid" 
                             data-fanex-grid-customer-details-report-fraud-case 
                             data-grid-data="cdrCtrl.FraudCaseDetails"
                             id="customer-details-report-fraud-case">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td valign="top">
                        Logs/Notes
                    </td>
                    <td>
                        <div class="freegrid" 
                             data-fanex-grid-customer-details-report-log-notes 
                             data-grid-data="cdrCtrl.LogNotes"
                             id="customer-details-report-log-notes">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                    </td>
                    <td>
                        <input type="text" ng-model="cdrCtrl.Note" placeholder="Input your notes here..."
                            style="width: 400px;" />
                        <button ng-click="cdrCtrl.addNote()" class="btn-green">
                            Add</button>
                    </td>
                </tr>
                <tr>
                    <td>
                        Delinquency
                    </td>
                    <td>
                        <input type="checkbox" ng-model="cdrCtrl.CustInfo.IsDelinquent" ng-change="cdrCtrl.updateDelinquency()" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div style="display: block;">
        <div style="font-weight: bold;">
            Daily Violated Tickets</div>
        <div ng-if="cdrCtrl.DailyViolatedTickets.length == 0">
            <b style="color: red;">Loading…</b>
        </div>
        <div ng-if="cdrCtrl.DailyViolatedTickets.length > 0" style="float: none;" class="freegrid"
             data-fanex-grid-customer-details-report-daily-violated-tickets 
             data-grid-data="cdrCtrl.DailyViolatedTickets"
             id="customer-details-report-daily-violated-tickets">
        </div>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div style="display: block;">
        <div style="font-weight: bold;">
            Win Loss Statistic</div>
        <div ng-if="cdrCtrl.EventChoices.length == 0">
            <b style="color: red;">Loading…</b>
        </div>
        <div ng-if="cdrCtrl.EventChoices.length > 0">
            <table>
                <tr>
                    <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                        <div class="report-header" style="margin-top: 0;">
                            <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                Summary
                            </div>
                        </div>
                        <div class="freegrid" 
                             data-fanex-grid-customer-details-report-summary 
                             data-grid-data="cdrCtrl.Summary"
                             id="customer-details-report-summary">
                        </div>
                    </td>
                    <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                        <div class="report-header" style="margin-top: 0;">
                            <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                Event Choice
                            </div>
                        </div>
                        <div class="freegrid"
                             data-fanex-grid-customer-details-report-event-choice
                             data-grid-data="cdrCtrl.EventChoices"
                             id="customer-details-report-event-choice">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                        <div class="report-header" style="margin-top: 0;">
                            <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                Top 5 sports by margin(%)
                            </div>
                        </div>
                        <div class="freegrid"
                             data-fanex-grid-customer-details-report-sport
                             data-grid-data="cdrCtrl.SportsByMargin"
                             id="customer-details-report-sport">
                        </div>
                    </td>
                    <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                        <div class="report-header" style="margin-top: 0;">
                            <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                Top 5 bet types by margin(%)
                            </div>
                        </div>
                        <div class="freegrid"
                             data-fanex-grid-customer-details-report-bettype
                             data-grid-data="cdrCtrl.BettypesByMargin"
                             id="customer-details-report-bettype">
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
