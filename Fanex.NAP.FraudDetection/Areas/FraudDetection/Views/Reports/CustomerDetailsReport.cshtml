@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Details";

}
@section HeadCss
{
    @Styles.Render("~/Content/betlist/FanexBetListCss")
    <link href="~/Content/Common/isteven-multi-select.css" rel="stylesheet" type="text/css" />
    <link href="~/Areas/FraudDetection/Content/suspiciouscustomerdetailreport.css" rel="stylesheet" type="text/css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/CustomerDetailsReport")
}
<div ng-controller="customerDetailsReportController as cdrCtrl">
    <div>
        <span class="infor-text">
            @ViewBag.Title
            @*<a class="back-button" ng-click="cdrCtrl.goBack()">← Back To List </a>*@
        </span>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div class="form-inline col-sm-12 filter-forml">
        <div class="col-sm-12" style="display: inline-block; vertical-align: middle; text-align: center;
            font-weight: bold;">
            <span style="padding-right: 50px;">
                Customer: {{ cdrCtrl.CustInfo.UserName }} ({{ cdrCtrl.CustInfo.CurrencyCode
                }})
            </span><span>
                Date Range: {{ cdrCtrl.GeneralInfo.FromDate }} ~ {{ cdrCtrl.GeneralInfo.ToDate
                }}
            </span>
        </div>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div>
        <div class="customer-details-header-icon" style="font-weight: bold;">
            <div style="margin-left: 20px;">
                Follow-Up Details
            </div>
        </div>
        <div class="suspicious-customer-follow-up-detail" style="margin-left: 20px;">
            <table class="col-sm-12">
                <tr>
                    <td>
                        <div style="height: 28px;">
                            Assignees
                        </div>
                    </td>
                    <td>
                        <div style="height: 28px;" ng-if="!cdrCtrl.EditAssingee.isEditAssignee" style="display: inline-block;">
                            <span style="height: 28px;">{{ cdrCtrl.EditAssingee.assignees }}</span>
                            <a ng-if="cdrCtrl.IsHost" ng-click="cdrCtrl.editAssingee()" class="btn-edit" href="javascript:;" style="display: inline-block; margin-top: -5px;"></a>
                        </div>
                        <div style="height: 28px;" ng-if="cdrCtrl.EditAssingee.isEditAssignee" style="display: inline-block;">
                            <div isteven-multi-select
                                 button-label="name"
                                 item-label="name"
                                 input-model="cdrCtrl.EditAssingee.Assignees"
                                 output-model="cdrCtrl.EditAssingee.AssigneesTicked"
                                 tick-property="ticked" style="display: inline-block;">
                            </div>
                            <a ng-if="cdrCtrl.IsHost" ng-click="cdrCtrl.saveEditAssingee()" class="btn-apply" style="display: inline-block;" href="javascript:;">Save</a>
                            <a ng-if="cdrCtrl.IsHost" ng-click="cdrCtrl.cancelEditAssingee()" class="btn-cancel" style="display: inline-block;" href="javascript:;">Cancel</a>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td valign="top" style="width: 100px;">
                        Fraud Cases
                    </td>
                    <td>
                        <div class="freegrid" data-fanex-grid-customer-details-report-fraud-case data-grid-data="cdrCtrl.FraudCaseDetails"
                             id="customer-details-report-fraud-case">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td valign="top">
                        Logs/Notes
                    </td>
                    <td>
                        <div class="freegrid" data-fanex-grid-customer-details-report-log-notes data-grid-data="cdrCtrl.LogNotes"
                             id="customer-details-report-log-notes">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td>
                        <input type="text" ng-model="cdrCtrl.Note" placeholder="Input your notes here..."
                               style="width: 400px;" />
                        <button ng-click="cdrCtrl.addNote()" class="btn-green">
                            Add
                        </button>
                    </td>
                </tr>
                <tr>
                    <td>
                        Delinquency
                    </td>
                    <td>
                        <input type="checkbox" ng-model="cdrCtrl.CustInfo.IsDelinquent" ng-change="cdrCtrl.updateDelinquency()" />
                    </td>
                </tr>
                <tr>
                    <td>
                        Hedge Account
                    </td>
                    <td>
                        <input id="checkBoxHedge" type="checkbox" ng-model="cdrCtrl.CustInfo.IsHedge" ng-change="cdrCtrl.updateHedgeAccount()" />
                        <label style="margin-left: 5px; cursor: pointer;" for="checkBoxHedge" class="glyphicon glyphicon-question-sign" title="{{ cdrCtrl.HedgeInfo }}"></label>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div style="display: block;">
        <div class="customer-details-header-icon" style="font-weight: bold;">
            <div style="margin-left: 20px;">
                Daily Violated Tickets
            </div>
        </div>
        <div class="suspicious-customer-follow-up-detail" style="margin-left: 20px;">
            <div ng-if="!cdrCtrl.DailyViolatedTicketsLoaded">
                <b style="color: red;">Loading…</b>
            </div>
            <div ng-if="cdrCtrl.DailyViolatedTicketsLoaded" style="float: none;" class="freegrid"
                 data-fanex-grid-customer-details-report-daily-violated-tickets data-grid-data="cdrCtrl.DailyViolatedTickets"
                 id="customer-details-report-daily-violated-tickets">
            </div>
        </div>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div style="display: block;">
        <div class="customer-details-header-icon" style="font-weight: bold;">
            <div style="margin-left: 20px;">
                Win Loss Statistic
            </div>
        </div>
        <div class="suspicious-customer-follow-up-detail" style="margin-left: 20px;">
            <div ng-if="!cdrCtrl.WinlossStatisticLoaded">
                <b style="color: red;">Loading…</b>
            </div>
            <div ng-if="cdrCtrl.WinlossStatisticLoaded">
                <table>
                    <tr>
                        <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                            <div class="report-header" style="margin-top: 0;">
                                <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                    Summary                                    
                                    <div id="btn_customermonthlywinloss" class="detail-statistic-data" ng-click="cdrCtrl.getWinlossMonthly()"></div>
                                </div>
                            </div>
                            <div class="freegrid" data-fanex-grid-customer-details-report-summary data-grid-data="cdrCtrl.Summary"
                                 id="customer-details-report-summary">
                            </div>
                        </td>
                        <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                            <div class="report-header" style="margin-top: 0;">
                                <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                    Event Choice
                                </div>
                            </div>
                            <div class="freegrid" data-fanex-grid-customer-details-report-event-choice data-grid-data="cdrCtrl.EventChoices"
                                 id="customer-details-report-event-choice">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                            <div class="report-header" style="margin-top: 0;">
                                <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                    Top 5 sports by margin(%)
                                </div>
                            </div>
                            <div class="freegrid" data-fanex-grid-customer-details-report-sport data-grid-data="cdrCtrl.SportsByMargin"
                                 id="customer-details-report-sport">
                            </div>
                        </td>
                        <td valign="top" style="padding-right: 15px; padding-bottom: 15px;">
                            <div class="report-header" style="margin-top: 0;">
                                <div style="font-weight: bold; margin-left: 5px; margin-top: 5px;">
                                    Top 5 bet types by margin(%)
                                </div>
                            </div>
                            <div class="freegrid" data-fanex-grid-customer-details-report-bettype data-grid-data="cdrCtrl.BettypesByMargin"
                                 id="customer-details-report-bettype">
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
