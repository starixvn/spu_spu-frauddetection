@model FD.Lib.Criteria.Reports.MatchMonitoringReportGetAllCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Report";
    
}
@section HeadCss
{
    @Styles.Render("~/bundles/FanexGrid/FanexGridCss")
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/Content/matchmonitoring.css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/MatchMonitoringReport")
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/Reports/matchmonitoring-report.js" type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.css"
        type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.js"
        type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/date-format.js" type="text/javascript"></script>
}
<h4>
    <b>Match Monitoring</b></h4>
<br>
@using (Html.BeginForm("Search", "MatchMonitoring", FormMethod.Get, new { @id = "formSearch", @class = "form-inline col-sm-12 filter-forml" }))
{
    <div class="form-group col-sm-12">
        <div class="col-sm-4" style="text-align: right;">
            <label class="text-right" style="margin-right: 10px;">
                Event Date</label>
                @Html.TextBox("EventDate", DateTime.Now.ToShortDateString(), new { @readonly = "readonly", style = "height:25px; width:100px;" })
                <i class="icon-calendar icon-event-date-calendar" id="eventDateDatetimePickerIcon" style=""></i>
        </div>
        <div class="col-sm-8">
            <label class="col-sm-5 text-right">
                League</label>
            <select name="Leagues" id="Leagues" style="height: 25px; width: 300px;">
                <option value="-1">All Leagues</option>
                @foreach (var league in ViewBag.Leagues)
                {
                    <option value="@league.LeagueId">@league.LeagueName</option>
                }
            </select>
        </div>
    </div>
    <div id="" style="height: 35px;">&nbsp;</div>
    <div class="form-group col-sm-12">
        <div class="col-sm-4" style="text-align: right;">
            <label class="text-right" style="margin-right: 10px;">
                Match Status</label>
            <select style="height: 25px; width: 118px;" id="MatchStatus">
                <option value="All">All</option>
                <option value="Completed">Completed</option>
                <option value="running">Running</option>
            </select>
        </div>
        <div class="col-sm-8">
            <label class="col-sm-5 text-right">
                Has Suspicious Customer(s)</label>
            <select style="height: 25px; width: 92px;" id="SuspiciousStatus">
                <option value="0">All</option>
                <option value="1">Yes</option>
                <option value="2">No</option>
            </select>
            <button class="btn-green" style="width: 100px; margin: 1px 0 0 10px;" id="btnSearch">Search</button>
        </div>
    </div>
}
<div id="matchSearch" class="newline">
    &nbsp;</div>
<div class="form-group col-sm-10" style="margin: 0 0 0 120px;">
    <div class="col-sm-3">
        <img class="ico-notscanned" alt="" title='Not scanned.'/>
        <label class="text-right" style="margin-right: 10px;">
            : Is not scanned</label>
    </div>
    <div class="col-sm-4">
        <img class="ico-scannednosuspicious" alt="" title='Scanned and has no suspicious case.'/>
        <label class="text-right">
            : Has NO suspicious Customer</label>
    </div>
    <div class="col-sm-4">
        <img class="ico-scannedhassuspicious" alt="" title='Scanned and has suspicious cases.'/>
        <label class="text-right">
            : Has suspicious Customer(s)</label>
    </div>
</div>
<div id="matchMonitoringReport" class="freegrid content-grid">
</div>
