@model IEnumerable<SelectListItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Report";
}
@section HeadCss
{
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/Content/suspiciouscustomerreport.css" />
    <link href="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.css"
        rel="stylesheet" type="text/css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/SuspiciousCustomerReport")

    <script src="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.js"
        type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/date-format.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">@ViewBag.Title</span>
</div>
<div class="newline">
    &nbsp;
</div>
@using (Html.BeginForm("Search", "SuspiciousCustomer", FormMethod.Get, new { @id = "formSearch", @class = "suspicious-customer-report-form-search form-inline filter-forml", @style = "text-align: left;" }))
{
    <div class="form-group col-sm-12" style="margin-left: -30px;">
        <div class="col-sm-4" style="text-align: left;">
            <label style="width: 110px; text-align: right; padding-right: 20px;">
                Event Date
            </label>
            @Html.TextBox("eventDateFrom", DateTime.Now.ToShortDateString(), new { @readonly = "readonly", style = "height:25px; width:75px;" })
            <i class="icon-calendar icon-event-date-calendar" id="eventDateDatetimePickerIconFrom"
                style=""></i>
        </div>
        <div class="col-sm-7">
            @Html.TextBox("eventDateTo", DateTime.Now.ToShortDateString(), new { @readonly = "readonly", style = "height:25px; width:75px;" })
            <i class="icon-calendar icon-event-date-calendar" id="eventDateDatetimePickerIconTo"
                style=""></i>
        </div>
    </div>
   <div id="" style="height: 35px;">&nbsp;</div>
    <div class="form-group col-sm-12" style="margin-left: -30px;">
        <div class="col-sm-4" >
            <label style="width: 110px; text-align: right; padding-right: 20px;">
                Member
            </label>
            @Html.TextBox("memberName", null, new { style = "height:25px; width:93px;" })
        </div>
        <div class="col-sm-8">
            <label style="text-align: right; padding-right: 20px;">
                Group
            </label>
            @Html.DropDownList("groupId", Model, new { @style = "height: 25px;" })
             <label style="padding-left: 20px;"></label>
            <button class="btn-green" id="btnSearch" style="width: 95px; margin: 1px 0 0 10px;">
                Generate
            </button>
        </div>
    </div>
}
<div class="newline">&nbsp;</div>

<div class="hidden report-header" id="report-header">
    <div class="export-excel-icon" id="btnExportExcel">
    </div>
</div>
<div id="customerReportId" class="freegrid content-grid">
</div>
