@model IEnumerable<SelectListItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Report";
}
@section HeadCss
{
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/Content/suspiciouscustomerreport.css" />
    <link href="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.css"
        rel="stylesheet" type="text/css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/SuspiciousCustomerReport")
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.js"
        type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/date-format.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">@ViewBag.Title</span>
</div>
<div class="newline">
    &nbsp;
</div>
<div ng-controller="suspiciousCustomerReportController as scrCtrl">
    <div class="form-inline filter-forml col-sm-12">
        <div class="form-group col-sm-12">
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 110px; text-align: right; padding-right: 20px;">
                    Event Date
                </label>
                <select ng-model="scrCtrl.eventDateValue" style="width: 125px; height: 25px;" ng-options="eventDate.Value as eventDate.Name for eventDate in scrCtrl.EventDateFilters"
                    ng-change="scrCtrl.changeEventDate()">
                </select>
            </div>
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 135px; text-align: right; padding-right: 20px;">
                    From Date
                </label>
                <input datetimepicker type="text" readonly="readonly" style="width: 107px; height: 25px;"
                    id="eventDateFrom" ng-click="scrCtrl.openCalendar('#eventDateFrom')" ng-model="scrCtrl.filter.EventDateFrom"
                    ng-change="scrCtrl.changeEventDateFromTo()" />
                <span class="icon-calendar icon-event-date-calendar" ng-click="scrCtrl.openCalendar('#eventDateFrom')">
                </span>
            </div>
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 135px; text-align: right; padding-right: 20px;">
                    To Date
                </label>
                <input type="text" readonly="readonly" style="width: 107px; height: 25px;" id="eventDateTo"
                    ng-click="scrCtrl.openCalendar('#eventDateTo')" ng-model="scrCtrl.filter.EventDateTo"
                    ng-change="scrCtrl.changeEventDateFromTo()" />
                <span class="icon-calendar icon-event-date-calendar" ng-click="scrCtrl.openCalendar('#eventDateTo')">
                </span>
            </div>
        </div>
        <div style="height: 35px;">
            &nbsp;</div>
        <div class="form-group col-sm-12">
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 110px; text-align: right; padding-right: 20px;">
                    Member
                </label>
                <input type="text" ng-model="scrCtrl.filter.MemberName" style="width: 125px; height: 25px;" />
            </div>
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 135px; text-align: right; padding-right: 20px;">
                    Total Violations &ge;
                </label>
                <input type="text" ng-model="scrCtrl.filter.TotalViolations" style="width: 125px;
                    height: 25px;" />
            </div>
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 135px; text-align: right; padding-right: 20px;">
                    New Violations &ge;
                </label>
                <input type="text" ng-model="scrCtrl.filter.NewViolations" style="width: 125px; height: 25px;" />
            </div>
        </div>
        <div style="height: 35px;">
            &nbsp;</div>
        <div class="form-group col-sm-12">
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 110px; text-align: right; padding-right: 20px;">
                    Delinquency
                </label>
                <select ng-model="scrCtrl.filter.IsDelinquent" style="width: 125px; height: 25px;"
                    ng-options="delinquent.Value as delinquent.Name for delinquent in scrCtrl.DelinquentStatuses">
                </select>
            </div>
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 135px; text-align: right; padding-right: 20px;">
                    Verification
                </label>
                <select ng-model="scrCtrl.filter.IsVerified" style="width: 125px; height: 25px;"
                    ng-options="verification.Value as verification.Name for verification in scrCtrl.VerificationStatuses">
                </select>
            </div>
            <div class="col-sm-3" style="text-align: left;">
                <label style="width: 135px; text-align: right; padding-right: 20px;">
                </label>
                <button class="btn-green" style="width: 95px; margin-left: 1px;" ng-click="scrCtrl.generateSuspiciousCustomerReport()">
                    Generate</button>
            </div>
        </div>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div class="row" ng-show="scrCtrl.SuspiciousCustomers">
        <div class="col-sm-12">
            <div class="report-header hidden" id="report-header">
                <div class="export-excel-icon" ng-click="scrCtrl.exportExcel()">
                </div>
            </div>
            <div class="freegrid" data-fanex-grid-suspicious-customer-report
                data-grid-data="scrCtrl.SuspiciousCustomers"
                data-page-option="scrCtrl.filter" data-on-page-changing="scrCtrl.pagingReport">
            </div>
        </div>
    </div>
</div>
