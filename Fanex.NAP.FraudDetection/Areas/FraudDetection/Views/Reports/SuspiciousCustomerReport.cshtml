@model IEnumerable<SelectListItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Report";
    
}
@section HeadCss
{
    @Styles.Render("~/bundles/FanexGrid/FanexGridCss")
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/Reports")
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/Reports/customer-report.js" type="text/javascript"></script>
}
<h4>
    <b>Customer Report</b></h4>
<br>
@using (Html.BeginForm("Search", "SuspiciousCustomer", FormMethod.Get, new { @id = "formSearch" }))
{
    <div class="col-md-12">
        <label>
            Member</label>
        @Html.TextBox("memberName", null, new { @style = "margin-left: 3px; padding-left: 5px; margin-right: 10px;" })
        <label>
            Group</label>
        @Html.DropDownList("groupId", Model, new { @style = "height: 25px; min-width:100px; margin-left: 3px; padding-left: 5px; margin-right: 10px;" })
        <button class="btn-green" id="btnSearch">
            Search</button>
    </div>
}
<div id="mailSearch" class="newline">
    &nbsp;</div>
<div id="customerReportId" class="freegrid content-grid">
</div>
