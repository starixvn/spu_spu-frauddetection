@model IEnumerable<SelectListItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Report";
}
@section HeadCss
{
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/Content/suspiciouscustomerreport.css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/SuspiciousCustomerReport")
}
<div>
    <span class="infor-text">@ViewBag.Title</span>
</div>
<div class="newline">
    &nbsp;
</div>
@using (Html.BeginForm("Search", "SuspiciousCustomer", FormMethod.Get, new { @id = "formSearch", @class = "suspicious-customer-report-form-search form-inline filter-forml", @style = "text-align: center;" }))
{
    <div style="display: inline-block; vertical-align: middle;">
        <label>
            Member
        </label>
        @Html.TextBox("memberName", null, new { @style = "height: 25px; margin-left: 3px; padding-left: 5px; margin-right: 10px;" })
        <label>
            Group
        </label>
        @Html.DropDownList("groupId", Model, new { @style = "height: 25px; min-width:100px; margin-left: 3px; padding-left: 5px; margin-right: 10px;" })
        <button class="btn-green" id="btnSearch">
            Search
        </button>
    </div>
}
<div id="mailSearch" class="newline">
    &nbsp;
</div>
<div class="hidden report-header" id="report-header">
    <div class="export-excel-icon" id="btnExportExcel"></div>
</div>
<div id="customerReportId" class="freegrid content-grid">
</div>
