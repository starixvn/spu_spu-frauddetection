@using FD.Lib.Criteria.Reports
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Fraud Case Details";
}

@model FD.Lib.Model.Reports.FraudCaseDetail.FraudCaseDetailReportViewModel
@section HeadCss
{
    @Styles.Render("~/Content/betlist/FanexBetListCss")
    <link href="~/Areas/FraudDetection/Content/fraudcasedetail.css" rel="stylesheet" />
}
<div class="hidden" id="MatchId">@Model.Summary.MatchId</div>
<div class="hidden" id="CaseId">@Model.Summary.CaseId</div>
<div class="hidden" id="EventDate">@Model.Summary.EventDate</div>
<div class="row">
    <div class="col-md-8">
        <h4>
            <b>Fraud Case Detail</b>
        </h4>
        <table class="table table-bordered">
            <tr>
                <td class="text-right font-bold col-md-2">
                    Case Name
                </td>
                <td>
                    <b>@Model.Summary.CaseName</b>
                </td>
            </tr>
            <tr>
                <td class="text-right font-bold col-md-2">
                    Event
                </td>
                <td>
                    @Html.Raw(string.Format("<b>{0}</b> -vs- <b>{1}</b>", Model.Summary.HomeName, Model.Summary.AwayName))
                </td>
            </tr>
            <tr>
                <td class="text-right font-bold col-md-2">
                    HT Score
                </td>
                <td>
                    @Model.Summary.DisplayHTScore
                </td>
            </tr>
            <tr>
                <td class="text-right font-bold col-md-2">
                    FT Score
                </td>
                <td>
                    @Model.Summary.DisplayFTScore
                </td>
            </tr>
            <tr>
                <td class="text-right font-bold col-md-2">
                    # Members
                </td>
                <td>
                    @Model.Summary.CustomerCount
                </td>
            </tr>
            <tr>
                <td class="text-right font-bold col-md-2">
                    # Tickets
                </td>
                <td>
                    @Model.Summary.BetCount
                </td>
            </tr>
        </table>
    </div>
</div>

@for (int i = 0; i < Model.Body.Count; i++)
{
    <div class="bettype-detail">
        @*<div class="hidden report-header" id="report-header-@i">
                <div class="export-excel-icon" id="btnExportExcel"></div>
            </div>*@
        <div id="fraudCaseDetailReport-@i" class="freegrid content-grid">
        </div>
    </div>
}

@section FooterJs
{
    <script type="text/javascript">
        var data = @Html.Raw(Json.Encode(Model.Body));
    </script>
    @Scripts.Render("~/bundles/App/FraudCaseDetail")
}
