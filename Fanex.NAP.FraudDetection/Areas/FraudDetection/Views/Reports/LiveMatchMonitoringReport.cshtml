@using System.Resources
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Live Match Monitoring";

}
@section HeadCss
{
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/Content/livematchmonitoring.css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/LiveMatchMonitoringReport")
}
<div>
    <span class="infor-text">@ViewBag.Title</span>
</div>
<div ng-controller="liveMatchMonitoringReportController as lmmrCtrl">
    <div class="form-inline filter-forml col-sm-12">
        <div class="form-group col-sm-12">
            <div class="col-sm-3">
                <div class="col-sm-5" style="text-align: right;">
                    <label style="padding-top: 5px;">
                        @Labels.EventDate
                    </label>
                </div>
                <div class="col-sm-7">
                    <input datetimepicker type="text" readonly="readonly" style="width: 80px; height: 25px;"
                           id="eventDate" ng-click="lmmrCtrl.openCalendar('#eventDate')" ng-model="lmmrCtrl.filter.EventDate"
                           ng-change="lmmrCtrl.changeEventDate()" />
                    <span class="icon-calendar icon-event-date-calendar" ng-click="lmmrCtrl.openCalendar('#eventDate')">
                    </span>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="col-sm-3" style="text-align: right;">
                    <label style="padding-top: 5px;">
                        @Labels.Sport
                    </label>
                </div>
                <div class="col-sm-9">
                    <select ng-model="lmmrCtrl.filter.SportId" style="width: 100%; height: 25px;"
                            ng-options="sport.SportId as sport.SportName for sport in lmmrCtrl.Sports"
                            ng-change="lmmrCtrl.changeSport()"></select>
                </div>
            </div>
            <div class="col-sm-5">
                <div class="col-sm-2" style="text-align: right;">
                    <label style="padding-top: 5px;">
                        @Labels.League
                    </label>
                </div>
                <div class="col-sm-10">
                    <select ng-model="lmmrCtrl.filter.LeagueId" class="league-select"
                            ng-options="league.LeagueId as league.LeagueName for league in lmmrCtrl.Leagues"></select>
                </div>
            </div>
        </div>
        <div style="height: 35px;">
            &nbsp;
        </div>
        <div class="form-group col-sm-12">
            <div class="col-sm-3">
                <div class="col-sm-5" style="text-align: right;">
                    <label style="padding-top: 5px;">
                        @Labels.MatchCode
                    </label>
                </div>
                <div class="col-sm-7">
                    <input type="text" ng-model="lmmrCtrl.filter.MatchCode" class="match-code" />
                </div>
            </div>
            <div class="col-sm-3">
                <div class="col-sm-3"></div>
                <div class="col-sm-9">
                    <span class="checkbox">
                        <input style="vertical-align: text-bottom;" id="checkboxMainMarket" type="checkbox"
                               ng-model="lmmrCtrl.filter.IsMainMarket" />
                        <label style="cursor: pointer; font-weight: normal;" for="checkboxMainMarket">Main Market Only</label>
                    </span>

                </div>
            </div>
            <div class="col-sm-5">
                <div class="col-sm-2">&nbsp;</div>
                <div class="col-sm-10">
                    <button style="width: 97px; height: 25px;" class="btn-green generate-button" ng-click="lmmrCtrl.queryLiveMatchMonitoringReport()">
                        Generate
                    </button>
                </div>
            </div>
        </div>
        <div style="height: 35px;">
            &nbsp;
        </div>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div class="row">
        <div class="form-group col-sm-12">
            <div class="col-sm-4" style="text-align: center;">
                <span class="ico-scannednosuspicious" title='Scanned and has no suspicious case.' style="vertical-align:middle;"></span>
                <span class="text-right" style="vertical-align:middle;">
                    @Labels.EverythingIsFine
                </span>
            </div>
            <div class="col-sm-4" style="text-align: center;">
                <span class="ico-scannedhassuspicious" title='Scanned and has suspicious cases.' style="vertical-align:middle;"></span>
                <span class="text-right" style="vertical-align:middle;">
                    @Labels.FraudDetected
                </span>
            </div>
            <div class="col-sm-4" style="text-align: center;">
                <span class="ico-notscanned" title='Not scanned.' style="vertical-align:middle;"></span>
                <span class="text-right" style="vertical-align: middle;">
                    @Labels.InQueue
                </span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="form-group col-sm-12" style="margin-top: -20px;">
            <div class="report-header hidden" id="report-header">
                <button id="btnRefresh" class="button-refresh" ng-click="lmmrCtrl.refreshLiveMatchMonitoringReport()">
                    <span class="refresh-icon" id="refreshIcon"></span>
                    <span id="secondRefresh" ng-bind="lmmrCtrl.RefreshSecond"></span>
                </button>
                <select ng-model="lmmrCtrl.RefreshSecond" class="select-refresh"
                        ng-change="lmmrCtrl.CountDownToRefresh()"
                        ng-options=" option.OptionId as option.OptionName for option in lmmrCtrl.RefreshOptions"></select>
            </div>
            <div id="match-monitoring-report" class="freegrid" data-fanex-grid-match-monitoring-report data-grid-data="lmmrCtrl.LiveMatchMonitoringReport">
            </div>
        </div>
    </div>
</div>
