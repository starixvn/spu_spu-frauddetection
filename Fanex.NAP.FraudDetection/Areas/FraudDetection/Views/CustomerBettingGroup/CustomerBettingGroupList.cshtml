@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Customer Betting Groups";
}
@section HeadCss
{
    @Styles.Render("~/bundles/FanexGrid/FanexGridCss")
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />
}
@section FooterJs
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    @Scripts.Render("~/bundles/App/CustomerBettingGroup")
    <script src="~/Areas/FraudDetection/Scripts/CustomerBettingGroup/customer-betting-group-list.js"
        type="text/javascript"></script>
}
<div>
    <span class="infor-text">All Customer Betting Groups</span>
</div>
<div class="newline">&nbsp;</div>
<div style="position: relative;">
    <div>
        <div id="customer-betting-group" class="freegrid  content-grid"></div>
    </div>

    <div style="position: absolute; left: 575px; top: 0;">
        <div id="customers-in-betting-group" class="freegrid  content-grid">
        </div>
    </div>
</div>
