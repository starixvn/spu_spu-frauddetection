@model SPU.Lib.FraudDetection.Criteria.CustomerBettingGroup.CustomerBettingGroupInsertCriteria
@{
    ViewBag.Title = "Add New Group";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using (Html.BeginForm("AddNewGroup", "CustomerBettingGroup", FormMethod.Post, new { @id = "AddGroupForm" }))
{
    <table class="table-popup">
        <tr>
            <td align="right">
                <span>Name</span>
            </td>
            <td>@Html.TextBoxFor(l => l.Name, new { @style = "width: 350px;" })
            </td>
        </tr>
        <tr>
            <td align="right">
                <span>Description</span>
            </td>
            <td>@Html.TextAreaFor(l => l.Description, 5, 45, new { @style = "width: 350px;" })
            </td>
        </tr>
        <tr>
            <td>
            </td>
            <td>
                <input type="button" id="btn_addGroup" value="Submit" class="btn-green font-size-small" />
                <input type="button" id="btn_Cancel" value="Cancel" class="btn-green btn-customCancel font-size-small" />
            </td>
        </tr>
    </table>
}
<br />
<label id="addResult" class="hidden" />
@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/CustomerBettingGroup/customer-betting-group-add.js"
        type="text/javascript"></script>
}
