@using System.Web.Optimization
@model SPU.Lib.FraudDetection.Criteria.ConfigParameterUpdateCriteria
@{        
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Configure Parameters";        
    
}

@section HeadCss
{
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridCss")" />
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />    
}
@section FooterJs
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/Parameter/parameter-update.js" type="text/javascript"></script>
}

<div>
    <span class="infor-text">Parameters</span>
</div>
<div class="newline">&nbsp;</div>

@using (Html.BeginForm("UpdateParamater", "Parameter", FormMethod.Post, new { @id = "UpdateParamater" }))
{    
    <div id="onUserid" style="display: none;">@Model.CreatorId</div>
    <table class="table-popup">
        <tr>
            <td align="right"><span>Big Stake</span></td>
            <td>
                @Html.TextBoxFor(l => l.PercentageMaxBet, new { @id = "percentageMaxBet", @style = "width: 150px;", @placeholder = "% of Max Bet" })
                <div class="more-info" title=" A ticket with the Stake amount reachs to this percentages of Max Bet will be considered as suspicious."></div>
            </td>
        </tr>
        <tr>
            <td align="right"><span>Period Time</span></td>
            <td>
                @Html.TextBoxFor(l => l.SecondsToGoal, new { @id = "secondsToGoal", @style = "width: 150px;", @placeholder = "Seconds to the goal" })
                <div class="more-info" title="Tickets were placed in the Period Time around the goal will be considerd as suspicious."></div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td><input type="button" id="btn_UpdateParameter" value="Submit" class="btn-green" /></td>
        </tr>
    </table>
    <label id="updateParamsResults" class="result-text-success"></label>
}
<br />
<label id="addResult" class="hidden" />
