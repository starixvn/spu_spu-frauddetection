@using Fanex.NAP.FraudDetection.Service.Core
@using Fanex.NAP.FraudDetection.Service.Utilities
@model Fanex.NAP.FraudDetection.Models.ViewModel.Paramater.ParameterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Configure Parameters";

}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/Parameter")
    <script src="~/Areas/FraudDetection/Scripts/Parameter/parameter-edit.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">All Parameters</span>
</div>
<div class="newline">
    &nbsp;
</div>
@using (Html.BeginForm("UpdateParamater", "Parameter", FormMethod.Post, new { @id = "UpdateParamater" }))
{
    <div id="onUserid" style="display: none;">@Model.OnUserId</div>
    <table class="table-popup">
        @{
    foreach (var param in Model.ParameterList)
    {
            <tr>
                <td align="right">
                    <span>@param.ParamDisplayName</span>
                </td>
                <td>
                    <input type="text" id="tb_param_@param.ParamId" value="@param.ParamValue" style="text-align: right;" />
                    <label>@param.ParamUnit</label>
                    <div class="more-info" title="@param.ParamDesc">
                    </div>
                </td>
            </tr>
    }
        }
        <tr>
            <td>
            </td>
            <td>
                @if (PermissionService.HasHostPermission(FDFunctionKeys.Parameter))
                {
                    <input type="button" id="btn_UpdateParameter" value="Submit" class="btn-green  font-size-small" />
                }
            </td>
        </tr>
    </table>
    <label id="updateParamsResults" class="result-text-success">
    </label>
}
