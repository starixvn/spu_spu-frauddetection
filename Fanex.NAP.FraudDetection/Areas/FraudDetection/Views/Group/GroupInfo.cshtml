@using System.Web.Optimization
@model SPU.Lib.FraudDetection.Criteria.GroupInsertCriteria
@{
    ViewBag.Title = "Add New Group";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
    Model.IsActive = true;
}

@using (Html.BeginForm("AddNewGroup", "Group", FormMethod.Post, new { @id = "AddGroupForm" }))
{
    <table class="table-popup">
        <tr>
            <td align="right"><span>Group Name</span></td>
            <td>@Html.TextBoxFor(l => l.GroupName, new { @style = "width: 338px;" })</td>
        </tr>
        <tr>
            <td align="right"><span>Description</span></td>
            <td>@Html.TextAreaFor(l => l.GroupDesc, 5, 45, new { @style = "width: 350px;" })</td>
        </tr>
        <tr>
            <td align="right"><span>Active</span></td>
            <td>@Html.CheckBoxFor(l => l.IsActive)</td>
        </tr>
        <tr>
            <td></td>
            <td><input type="submit" id="btn_AddGroup" value="Add" class="btn-green" /></td>
        </tr>
    </table>
}
<br />
<label id="addResult" class="hidden" />

@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/Group/group-add.js" type="text/javascript"></script>
}
