@using FD.Lib.Criteria.Reports
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Fraud Case Details";    
}

@model FD.Lib.Model.Reports.FraudCaseDetail.FraudCaseDetailReportViewModel

@section HeadCss
{
    @Styles.Render("~/bundles/FanexGrid/FanexGridCss")
    @Styles.Render("~/bundles/FanexBetListCss")
    
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />
}

<div class="row">
    <div class="col-md-5">
        <h4>
            <b>Fraud Case Detail</b>
        </h4>
        <table class="table table-bordered">
            <tr>
                <td class="text-right font-bold">Event</td>
                <td>@Html.Raw(string.Format("<b>{0}</b> vs <b>{1}</b>", Model.Summary.HomeName, Model.Summary.AwayName))</td>
            </tr>
            <tr>
                <td class="text-right font-bold"># Members</td>
                <td>@Model.Summary.CustomerCount</td>
            </tr>
            <tr> 
                <td class="text-right font-bold"># Tickets</td>
                <td>@Model.Summary.BetCount</td>
            </tr>
        </table>
    </div>
</div>

<div class="newline"> &nbsp;</div>

<div id="fraudCaseDetailReportId" class="freegrid content-grid"></div>

@section FooterJs
{
    @Scripts.Render("~/bundles/App/Reports")
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    <script type="text/javascript">
        var data = @Html.Raw(Json.Encode(Model.Body));
    </script>

    <script src="~/Areas/FraudDetection/Scripts/FraudCaseDetail/fraudcasedetail-service.js"></script>
}