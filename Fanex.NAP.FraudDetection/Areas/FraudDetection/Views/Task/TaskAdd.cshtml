@using Fanex.NAP.FraudDetection.Areas.FraudDetection.Models.ViewModel.Task;
@model TaskModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Add New Task";
}
@section HeadCss
{
    <link href="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.css"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/FraudDetection/Content/task.css" rel="stylesheet" type="text/css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/Task")
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/jquery-ui-timepicker-addon.js"
        type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/AddOns/TimePicker/date-format.js" type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/Core/mathformula-validation.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">@ViewBag.Title</span> <span class="button-action"><a class="back-button"
        onclick="window.history.back();">← Back To List </a></span>
</div>
<div ng-controller="taskAddController as taskCtr">
    <div id="caseid" style="display: none;">@Model.CaseId</div>
    <div id="onUserid" style="display: none;">@Model.UserId</div>
    @Html.Partial("~/Areas/FraudDetection/Views/Task/ProgressBar.cshtml")
    @Html.Partial("~/Areas/FraudDetection/Views/Task/General.cshtml")
    @Html.Partial("~/Areas/FraudDetection/Views/Task/Event.cshtml")
    @Html.Partial("~/Areas/FraudDetection/Views/Task/Activity.cshtml")
    @Html.Partial("~/Areas/FraudDetection/Views/Task/Rule.cshtml")
    @Html.Partial("~/Areas/FraudDetection/Views/Task/Summary.cshtml")
</div>
