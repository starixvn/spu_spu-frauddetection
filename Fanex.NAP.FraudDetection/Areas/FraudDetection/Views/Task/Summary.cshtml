@using Fanex.NAP.FraudDetection.Service.Core
@using Fanex.NAP.FraudDetection.Service.Utilities
<div ng-show="taskCtr.tab.summary" style="width: 800px;">
    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered">
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Task Name
                    </td>
                    <td>
                        {{ taskCtr.Model.General.TaskName }}
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Description
                    </td>
                    <td>
                        {{ taskCtr.Model.General.TaskDesc }}
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Active
                    </td>
                    <td ng-show="taskCtr.Model.General.IsActive">
                        Yes
                    </td>
                    <td ng-show="!taskCtr.Model.General.IsActive">
                        No
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Event Name
                    </td>
                    <td ng-show="1 == taskCtr.Model.Event.EventId">
                        Background Processing ({{ taskCtr.Model.Event.Timer }} {{ taskCtr.Model.Event.TimerUnit
                        }}s)
                    </td>
                    <td ng-show="2 == taskCtr.Model.Event.EventId">
                        <span ng-show="task.TaskId == taskCtr.Model.Event.BackGroundTaskId" ng-repeat="task in taskCtr.BackGroundTasks">
                            Trigger By Another Task (Executed Affter: {{ task.TaskName}})
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Activity
                    </td>
                    <td>
                        <span ng-show="activity.ActivityId == taskCtr.Model.Activity.ActivityId" ng-repeat="activity in taskCtr.Activities">
                            {{ activity.ActivityName}}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Precondition
                    </td>
                    <td>
                        <table class="">
                            <tr ng-repeat="item in taskCtr.Model.Rule.PreconditionTable">
                                <td>
                                    {{ taskCtr.rowFormula(item, false) }}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Rule
                    </td>
                    <td>
                        <table class="">
                            <tr ng-repeat="item in taskCtr.Model.Rule.RuleTable">
                                <td>
                                    {{ taskCtr.rowFormula(item, true) }}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="text-right font-bold col-md-2">
                        Next Actions
                    </td>
                    <td>
                        <span ng-show="taskCtr.nextActionAssignGroup.IsTicked">
                            {{ taskCtr.NextActions[0].Name
                            }} (<span ng-show="group.GroupId == taskCtr.nextActionAssignGroup.ActionTargetId"
                                      ng-repeat="group in taskCtr.CustomerGroups">{{ group.GroupName }}</span>)<br />
                        </span>
                        <span ng-show="taskCtr.nextActionSendMail.IsTicked">
                            {{ taskCtr.NextActions[1].Name
                            }} (<span ng-show="mail.MailId == taskCtr.nextActionSendMail.ActionTargetId"
                                      ng-repeat="mail in taskCtr.Mails">{{ mail.MailCode }}</span>)<br />
                        </span>
                        <span ng-show="taskCtr.nextActionPostMessage.IsTicked">
                            {{ taskCtr.NextActions[3].Name
                            }} (<span ng-show="message.MessageId == taskCtr.nextActionPostMessage.ActionTargetId"
                                      ng-repeat="message in taskCtr.Messages">{{ message.MessageCode }}</span>)<br />
                        </span>
                        <span ng-show="taskCtr.nextActionCaptureData.IsTicked">
                            {{ taskCtr.NextActions[2].Name
                            }} (<span ng-show="dataType.IsChecked" ng-repeat="dataType in taskCtr.DataTypes">{{ dataType.DataName }};</span>)
                        </span>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div style="width: 800px; text-align: center;">
        <input type="button" ng-click="taskCtr.backToRule()" value="Back" class="btn-green btn-customConfirm font-size-small" />
        @if (PermissionService.HasHostPermission(FDFunctionKeys.FraudCase))
        {
            <input type="button" ng-click="taskCtr.addEditTask()" value="Finish" class="btn-green btn-customConfirm font-size-small" />
        }
    </div>
    <br>
</div>
