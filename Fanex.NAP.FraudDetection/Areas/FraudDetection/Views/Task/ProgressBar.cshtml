<div style="width: 800px; text-align: center; display: inline-block;">
    <ol class="task-progress" data-steps="5">
        <li ng-class="taskCtr.taskProgress.general"><span class="name">General</span> <span
            class="step" ng-click="taskCtr.goToStep(1)"><span>1</span></span> </li>
        <li ng-class="taskCtr.taskProgress.event"><span class="name">Event</span> <span class="step"
            ng-click="taskCtr.goToStep(2)"><span>2</span></span> </li>
        <li ng-class="taskCtr.taskProgress.activity"><span class="name">Activity</span> <span
            class="step" ng-click="taskCtr.goToStep(3)"><span>3</span></span> </li>
        <li ng-class="taskCtr.taskProgress.rule"><span class="name">Rule</span> <span class="step"
            ng-click="taskCtr.goToStep(4)"><span>4</span></span> </li>
        <li ng-class="taskCtr.taskProgress.summary"><span class="name">Summary</span> <span class="step"
            ng-click="taskCtr.goToStep(5)"><span>5</span></span> </li>
    </ol>
</div>
