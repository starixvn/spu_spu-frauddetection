<div ng-show="taskCtr.tab.rule" style="width: 800px; display: inline-block;">
    <div class="panel panel-default">
        <div class="panel-body">
            <div id="accordion">
                <h3 id="accordionBlockPrecondition">
                    Pre-condition
                </h3>
                <div>
                    <div class="table-popup font-size-small">
                        <select ng-model="taskCtr.preconditionRow.Param" style="height: 25px;" ng-options="config as config.ConfigName for config in taskCtr.Preconditions | filter:taskCtr.showInPrecondition"
                            ng-change="taskCtr.changePreCondition()">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Operator" style="height: 25px;" ng-options="operator as operator.Name for operator in taskCtr.Operators"
                            ng-change="">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Value" ng-show="taskCtr.CompareWithOtherField.InPrecondition"
                            style="height: 25px;" ng-options="config as config.ConfigName for config in taskCtr.ComparePreconditions | filter:taskCtr.showInComparePrecondition"
                            ng-change="">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Value" style="height: 25px;" ng-show="taskCtr.preconditionRow.Param.ConfigName == 'Match Status' && !taskCtr.CompareWithOtherField.InPrecondition"
                            ng-options="matchStatus as matchStatus.Name for matchStatus in taskCtr.MatchStatuses"
                            ng-change="">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Value" style="height: 25px;" ng-show="taskCtr.preconditionRow.Param.ConfigName == 'Match State' && !taskCtr.CompareWithOtherField.InPrecondition"
                            ng-options="matchState as matchState.Name for matchState in taskCtr.MatchStates"
                            ng-change="">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Value" style="height: 25px;" ng-show="taskCtr.preconditionRow.Param.ConfigName == 'League Type' && !taskCtr.CompareWithOtherField.InPrecondition"
                            ng-options="league as league.Name for league in taskCtr.LeagueTypes" ng-change="">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Value" style="height: 25px;" ng-show="taskCtr.preconditionRow.Param.ConfigName == 'Sport' && !taskCtr.CompareWithOtherField.InPrecondition"
                            ng-options="sport as sport.SportName for sport in taskCtr.Sports" ng-change="">
                        </select>
                        <select ng-model="taskCtr.preconditionRow.Value" style="height: 25px;" ng-show="taskCtr.preconditionRow.Param.ConfigName == 'Customer Group' && !taskCtr.CompareWithOtherField.InPrecondition"
                            ng-options="group as group.GroupName for group in taskCtr.CustomerGroups" ng-change="">
                        </select>
                        <input type="text" ng-model="taskCtr.preconditionRow.Value" style="width: 100px;
                            height: 25px;" ng-show="taskCtr.preconditionRow.Param.ConfigName == 'Match Code' && !taskCtr.CompareWithOtherField.InPrecondition" />
                        <input type="text" ng-model="taskCtr.preconditionRow.AdditionalValue" style="width: 100px;
                            height: 25px;" ng-show="(taskCtr.preconditionRow.Param.ConfigName == 'Match Date' || taskCtr.preconditionRow.Param.ConfigName == 'Scanned Date') && taskCtr.CompareWithOtherField.InPrecondition" />
                        <input type="text" readonly="readonly" style="width: 100px; height: 25px;" id="preconditionDateTimePicker"
                            ng-click="taskCtr.openCalendar('#preconditionDateTimePicker')" ng-show="(taskCtr.preconditionRow.Param.ConfigName == 'Match Date' || taskCtr.preconditionRow.Param.ConfigName == 'Scanned Date') && !taskCtr.CompareWithOtherField.InPrecondition" />
                        <span class="icon-calendar icon-event-date-calendar" ng-click="taskCtr.openCalendar('#preconditionDateTimePicker')"
                            ng-show="(taskCtr.preconditionRow.Param.ConfigName == 'Match Date' || taskCtr.preconditionRow.Param.ConfigName == 'Scanned Date') && !taskCtr.CompareWithOtherField.InPrecondition">
                        </span>
                        <input type="button" ng-click="taskCtr.addPrecondition()" value="Add to List" class="btn-green font-size-small" />
                        <div class="newline">
                            &nbsp;
                        </div>
                        <div>
                            <input type="checkbox" ng-model="taskCtr.CompareWithOtherField.InPrecondition" ng-change="taskCtr.changeComparePrecondition()" />
                            Compare with another field
                        </div>
                        <div class="newline">
                            &nbsp;
                        </div>
                        <div style="border: 1px solid #000000;">
                            <table class="table-items">
                                <tr ng-repeat="item in taskCtr.Model.Rule.PreconditionTable">
                                    <td>
                                        <input ng-model="item.IsChecked" type="checkbox" />
                                    </td>
                                    <td style="width: 800px;">
                                        {{ taskCtr.rowFormula(item, false) }}
                                    </td>
                                    <td>
                                        <img ng-click="taskCtr.removePrecondition(item)" src="{{ taskCtr.deleteIcon }}" style="cursor: pointer;
                                            cursor: hand;" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="newline">
                            &nbsp;
                        </div>
                        <label ng-show="taskCtr.IsCheckingPrecondition">
                            {{ taskCtr.tableFormula(taskCtr.Model.Rule.PreconditionTable, false) }}
                        </label>
                        <label id="preconditionTableFormula" ng-show="!taskCtr.IsCheckingPrecondition">
                        </label>
                        <div class="newline">
                            &nbsp;
                        </div>
                        <div ng-repeat="item in taskCtr.FormulaElements" style="display: inline-block;">
                            <input type="button" ng-click="taskCtr.addRemoveFormulaElementInPrecondition(item)"
                                value="{{item.Name}}" class="btn-green font-size-small" />&nbsp;
                        </div>
                    </div>
                </div>
                <h3 id="accordionBlockRule">
                    Rule
                </h3>
                <div>
                    <div class="table-popup font-size-small">
                        <select ng-model="taskCtr.ruleRow.Param" style="height: 25px;" ng-options="config as config.ConfigName for config in taskCtr.Rules | filter:taskCtr.showInRule"
                            ng-change="taskCtr.changeRule()">
                        </select>
                        <select ng-model="taskCtr.ruleRow.Operator" style="height: 25px;" ng-options="operator as operator.Name for operator in taskCtr.Operators"
                            ng-change="">
                        </select>
                        <input type="text" ng-model="taskCtr.ruleRow.AdditionalValue" style="width: 100px;
                            height: 25px;" ng-show="taskCtr.ruleRow.Param.ConfigName == 'Stake' && taskCtr.CompareWithOtherField.InRule" />
                        <select ng-model="taskCtr.ruleRow.Value" ng-show="taskCtr.CompareWithOtherField.InRule"
                            style="height: 25px;" ng-options="config as config.ConfigName for config in taskCtr.CompareRules | filter:taskCtr.showInCompareRule"
                            ng-change="">
                        </select>
                        @*Text box*@
                        <input type="text" ng-model="taskCtr.ruleRow.Value" style="width: 100px; height: 25px;"
                            ng-show="taskCtr.DataInRule.TextBox && !taskCtr.CompareWithOtherField.InRule" />
                        @*Date Time*@
                        <input type="text" readonly="readonly" style="width: 100px; height: 25px;" id="ruleDateTimePicker"
                            ng-click="taskCtr.openCalendar('#ruleDateTimePicker')" ng-show="taskCtr.DataInRule.DateTime && !taskCtr.CompareWithOtherField.InRule" />
                        <span class="icon-calendar icon-event-date-calendar" ng-click="taskCtr.openCalendar('#ruleDateTimePicker')"
                            ng-show="taskCtr.DataInRule.DateTime && !taskCtr.CompareWithOtherField.InRule">
                        </span>@*Combo box*@
                        <select ng-model="taskCtr.ruleRow.Value" style="height: 25px;" ng-show="taskCtr.ruleRow.Param.ConfigName == 'Ticket Status' && !taskCtr.CompareWithOtherField.InRule"
                            ng-options="status as status.Name for status in taskCtr.TicketStatuses" ng-change="">
                        </select>
                        <select ng-model="taskCtr.ruleRow.Value" style="height: 25px;" ng-show="taskCtr.ruleRow.Param.ConfigName == 'Bet Type' && !taskCtr.CompareWithOtherField.InRule"
                            ng-options="type as type.BettypeName for type in taskCtr.BetTypes" ng-change="">
                        </select>
                        <select ng-model="taskCtr.ruleRow.Value" style="height: 25px;" ng-show="taskCtr.ruleRow.Param.ConfigName == 'Currency' && !taskCtr.CompareWithOtherField.InRule"
                            ng-options="currency as currency.CurrencyName for currency in taskCtr.Currencies"
                            ng-change="">
                        </select>
                        <select ng-model="taskCtr.ruleRow.Value" style="height: 25px;" ng-show="taskCtr.ruleRow.Param.ConfigName == 'Choice' && !taskCtr.CompareWithOtherField.InRule"
                            ng-options="choice as choice.Name for choice in taskCtr.Choices" ng-change="">
                        </select>
                        <select ng-model="taskCtr.ruleRow.Value" style="height: 25px;" ng-show="taskCtr.ruleRow.Param.ConfigName == 'Arbitrage' && !taskCtr.CompareWithOtherField.InRule"
                            ng-options="arbitrage as arbitrage.Name for arbitrage in taskCtr.Arbitrages"
                            ng-change="">
                        </select>
                        @*IP Address*@
                        <input type="text" id="IpAddress" style="width: 120px; height: 25px;" ng-show="taskCtr.DataInRule.IpAddress && !taskCtr.CompareWithOtherField.InRule && taskCtr.ruleRow.Operator.Name != 'between'" />
                        <input type="text" id="IpAddressFrom" style="width: 120px; height: 25px;" ng-show="taskCtr.DataInRule.IpAddress && !taskCtr.CompareWithOtherField.InRule && taskCtr.ruleRow.Operator.Name == 'between'" />
                        <input type="text" id="IpAddressTo" style="width: 120px; height: 25px;" ng-show="taskCtr.DataInRule.IpAddress && !taskCtr.CompareWithOtherField.InRule && taskCtr.ruleRow.Operator.Name == 'between'" />
                        <input type="button" ng-click="taskCtr.addRule()" value="Add to List" class="btn-green font-size-small" />
                        <div>
                            <input type="checkbox" ng-model="taskCtr.CompareWithOtherField.InRule" ng-change="taskCtr.changeCompareRule()" />
                            Compare with another field
                        </div>
                        <div class="newline">
                            &nbsp;
                        </div>
                        <div style="border: 1px solid #000000;">
                            <table class="table-items">
                                <tr ng-repeat="item in taskCtr.Model.Rule.RuleTable">
                                    <td>
                                        <input ng-model="item.IsChecked" type="checkbox" />
                                    </td>
                                    <td style="width: 800px;">
                                        {{ taskCtr.rowFormula(item, true) }}
                                    </td>
                                    <td>
                                        <img ng-click="taskCtr.removeRule(item)" src="{{ taskCtr.deleteIcon }}" style="cursor: pointer;
                                            cursor: hand;" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="newline">
                            &nbsp;
                        </div>
                        <label ng-show="taskCtr.IsCheckingRule">
                            {{ taskCtr.tableFormula(taskCtr.Model.Rule.RuleTable, true) }}
                        </label>
                        <label id="ruleTableFormula" ng-show="!taskCtr.IsCheckingRule">
                        </label>
                        <div class="newline">
                            &nbsp;
                        </div>
                        <div ng-repeat="item in taskCtr.FormulaElements" style="display: inline-block;">
                            <input type="button" ng-click="taskCtr.addRemoveFormulaElementInRule(item)"
                                value="{{item.Name}}" class="btn-green font-size-small" />&nbsp;
                        </div>
                    </div>
                </div>
                <h3 id="accordionBlockPerform">
                    Perform
                </h3>
                <div>
                    <table class="table-popup font-size-small">
                        <tr ng-show=" taskCtr.Model.Activity.ActivityId == 1 || taskCtr.Model.Activity.ActivityId == 2 ">
                            <td>
                                <div>
                                    <input type="checkbox" ng-model="taskCtr.nextActionAssignGroup.IsTicked" />
                                    <span style="padding-bottom: 5px;">{{ taskCtr.NextActions[0].Name }}</span>
                                </div>
                            </td>
                            <td ng-show="taskCtr.nextActionAssignGroup.IsTicked">
                                <select ng-model="taskCtr.nextActionAssignGroup.ActionTargetId" style="height: 25px;"
                                    ng-options="group.GroupId as group.GroupName for group in taskCtr.CustomerGroups">
                                </select>
                            </td>
                        </tr>
                        <tr ng-show=" taskCtr.Model.Activity.ActivityId == 1 || taskCtr.Model.Activity.ActivityId == 2 ">
                            <td>
                                <div>
                                    <input type="checkbox" ng-model="taskCtr.nextActionSendMail.IsTicked" />
                                    {{ taskCtr.NextActions[1].Name }}
                                </div>
                            </td>
                            <td ng-show="taskCtr.nextActionSendMail.IsTicked">
                                <select ng-model="taskCtr.nextActionSendMail.ActionTargetId" style="height: 25px;"
                                    ng-options="mail.MailId as mail.MailCode for mail in taskCtr.Mails">
                                </select>
                            </td>
                        </tr>
                        <tr ng-show=" taskCtr.Model.Activity.ActivityId == 3 || taskCtr.Model.Activity.ActivityId == 4 ">
                            <td>
                                <div>
                                    <input type="checkbox" ng-model="taskCtr.nextActionCaptureData.IsTicked" />
                                    {{ taskCtr.NextActions[2].Name }} <span data-placement="top" data-toggle="tooltip"
                                        title="Generated data will be kept in 14 days only." style="margin-left: 5px;
                                        cursor: pointer;" class="glyphicon glyphicon-question-sign"></span>
                                </div>
                            </td>
                            <td ng-show="taskCtr.nextActionCaptureData.IsTicked">
                                <div class="btn-group">
                                    <button data-toggle="dropdown" class="btn btn-default dropdown-toggle">
                                        Choose data type <span class="caret"></span>
                                    </button>
                                    <br>
                                    <ul class="dropdown-menu dropdown-menu-form" style="position: relative; min-width: 200px;">
                                        <li ng-repeat="dataType in taskCtr.DataTypes">
                                            <input style="margin: 5px;" type="checkbox" ng-model="dataType.IsChecked" id="captureData_value_{{ dataType.DataId }}" />
                                            <label style="font-weight: normal; font-size: small;" for="captureData_value_{{ dataType.DataId }}">
                                                {{ dataType.DataName }}</label>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div style="width: 800px; text-align: center;">
        <input type="button" ng-click="taskCtr.backToActivity()" value="Back" class="btn-green btn-customConfirm font-size-small" />
        <input type="button" ng-click="taskCtr.nextToSummary()" value="Next" class="btn-green btn-customConfirm font-size-small" />
    </div>
</div>
