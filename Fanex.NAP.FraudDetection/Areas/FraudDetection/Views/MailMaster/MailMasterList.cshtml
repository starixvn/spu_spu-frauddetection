@using System.Web.Optimization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Mail Master";
    
}
@section HeadCss
{
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridCss")" />
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionCss")" />
    <link rel="stylesheet" type="text/css" href="~/Areas/FraudDetection/App_Themes/site.css" />
}
@section FooterJs
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FanexGridJs")" type="text/ecmascript"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/FraudDetectionJs")" type="text/ecmascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/MailMaster/mailmaster-list.js" type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/MailMaster/mailmaster-edit.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">All Mails</span>
    <input  class="btn-green" type="button" value="+ Add new Mail"
            onclick="location.href='@Url.Action("Add", "MailMaster")'" />
</div>
<div id="mailSearch" class="newline">
    &nbsp;</div>
<div id="mailMasterId" class="freegrid content-grid">
</div>
