@using System.Web.Optimization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Mail Master";

}
@section HeadCss
{
    <link href="@Url.Content("~/Areas/FraudDetection/Content/mailmaster.css")" rel="stylesheet" type="text/css" />
}
@section FooterJs
{
    @Scripts.Render("~/bundles/App/MailMaster")
    <script src="~/Areas/FraudDetection/Scripts/MailMaster/mailmaster-list.js" type="text/javascript"></script>
}
<div>
    <span class="infor-text">All Mails</span>
    <input class="btn-green" type="button" value="+ Add Mail"
           onclick="location.href='@Url.Action("AddMail", "MailMaster")'" />
</div>
<div id="mailSearch" class="newline">
    &nbsp;
</div>
<div id="mailMasterId" class="freegrid content-grid">
</div>
