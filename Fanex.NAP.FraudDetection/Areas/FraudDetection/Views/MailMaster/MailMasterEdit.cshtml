@using Fanex.NAP.FraudDetection.Service.Core
@using Fanex.NAP.FraudDetection.Service.Utilities
@model FD.Lib.Criteria.MailMaster.MailMasterUpdateCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Update Mail";
}
<h4>
    <b>Mail Master</b></h4>
@using (Html.BeginForm("EditMail", "MailMaster", FormMethod.Post, new { @id = "editMailForm" }))
{
    @Html.HiddenFor(model => model.MailId)
    @Html.HiddenFor(model => model.MailCode)
    @Html.HiddenFor(model => model.MailingListId)
    
    <div class="filter-form col-sm-12">
        <div class="col-sm-12">
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Mail Code</label>
                @Html.TextBoxFor(model => model.MailCode, new { @class = "inputbox col-sm-8 ui-corner-all", @style = "width: 380px", @disabled = true })
            </div>
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Description</label>
                @Html.TextBoxFor(model => model.MailDesc, new { @class = "inputbox col-md-8 ui-corner-all", @style = "width: 380px" })
            </div>
        </div>
        <div class="col-sm-12">
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    To</label>
                <ul id="To" style="width: 380px;"></ul>
                @Html.TextBoxFor(model => model.To, new { @id = "FakeTo", @class = "inputbox col-md-8 ui-corner-all", @style = "width: 380px; height: 35px; margin-top: -10px" })
                
            </div>
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Active</label>
                @Html.CheckBoxFor(model => model.IsActive, new { @checked = "checked" })
            </div>
        </div>
        <div class="col-sm-12">
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    CC</label>
                <ul id="CcTo" style="width: 380px;"></ul>
                @Html.TextBoxFor(model => model.CcTo, new { @id = "FakeCcTo", @class = "inputbox col-md-8 ui-corner-all", @style = "width: 380px; height: 35px; margin-top: -10px" })
                
            </div>
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    BCC</label>
                <ul id="BccTo" style="width: 380px;"></ul>
                @Html.TextBoxFor(model => model.BccTo, new { @id = "FakeBccTo", @class = "inputbox col-md-8 ui-corner-all", @style = "width: 380px; height: 35px; margin-top: -10px" })
                
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body" style="padding-bottom: 0;">
            <label class="col-sm-12" style="padding-left: 0">
                Subject</label>
            @Html.TextBoxFor(model => model.MailSubject, new { @class = "form-group col-sm-12", @style = "padding-left: 5px;" })
            <div class="col-md-12" style="padding: 0">
                <div class="form-group col-md-10" style="padding-left: 0">
                    @Html.TextAreaFor(model => model.MailContent, new { @class = "editor", @id = "editor", @style = "resize: none; height: 350px;" })
                </div>
                <div class="list-group col-md-2" style="height: 490px; border: 1px solid #9E9E9E;
                    padding: 10px;">
                    <div onclick="insertSuspiciousStatistic('Suspicious Statistic');" class="suspicious-statistic list-group-item">
                        Suspicious Statistic</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="form-group text-center col-md-12">
        @if (PermissionService.HasHostPermission(FDFunctionKeys.MailMaster))
        {
            <input id="btn_editMail" type="button" value="Submit" class="btn-green" />
        }
        <input id="btn_cancelMail" type="button" value="Cancel" class="btn-green" />
    </div>
}
<br />
@section HeadCss
{
    <link href="@Url.Content("~/Areas/FraudDetection/Content/mailmaster.css")" rel="stylesheet" type="text/css" />
    @Styles.Render("~/bundles/TagItCss")
}
@section FooterJs
{
    @Scripts.Render("~/bundles/TagItJs")
    @Scripts.Render("~/bundles/App/MailMaster")
    <script src="~/Scripts/tinymce/tinymce.min.js" type="text/javascript"></script>
    <script src="~/Areas/FraudDetection/Scripts/MailMaster/mailmaster-edit.js" type="text/javascript"></script>
}
