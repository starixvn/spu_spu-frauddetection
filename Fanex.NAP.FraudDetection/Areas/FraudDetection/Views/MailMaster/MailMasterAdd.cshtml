@model SPU.Lib.FraudDetection.Criteria.MailMaster.MailMasterInsertCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "New Mail";
}
<h4>
    <b>Mail Master</b></h4>
@using (Html.BeginForm("AddNewMail", "MailMaster", FormMethod.Post, new { @id = "addNewMailForm" }))
{
    <div class="filter-form col-sm-12">
        <div class="form-group col-sm-12">
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Mail Code</label>
                @Html.TextBoxFor(model => model.MailCode, new { @class = "col-sm-8" })
            </div>
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Mailing List</label>
                @Html.TextBoxFor(model => model.MailingListId, new { @class = "col-md-8", @style = "max-width: 150px;" })
            </div>
        </div>
        <div class="form-group col-sm-12">
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Description</label>
                @Html.TextBoxFor(model => model.MailDesc, new { @class = "col-md-8" })
            </div>
            <div class="col-sm-6">
                <label class="col-sm-3 text-right">
                    Active</label>
                @Html.CheckBoxFor(model => model.IsActive, new { @checked = "checked" })
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body" style="padding-bottom: 0;">
            <label class="col-sm-12" style="padding-left: 0">
                Subject</label>
            @Html.TextBoxFor(model => model.MailSubject, new { @class = "form-group col-sm-12", @style = "padding-left: 5px;" })
            <div class="col-sm-12" style="padding: 0">
                <div class="form-group col-sm-10" style="padding-left: 0">
                    @Html.TextAreaFor(model => model.MailContent, new { @class = "editor", @id = "editor" })
                </div>
                <div class="col-sm-2 list-group" style="height: 490px; border: 1px solid #9E9E9E;
                    padding: 10px;">
                    <a href="#" onclick="insertSuspiciousStatistic('Suspicious Statistic');" class="btn-warning suspicious-statistic list-group-item">
                        Suspicious Statistic</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="form-group text-center col-md-12">
        <input id="btn_addMail" type="button" value="Submit" class="btn-green" />
        <input id="btn_cancelMail" type="button" value="Cancel" class="btn-green" />
    </div>
}
<br />
@section HeadCss
{
    <link href="@Url.Content("~/Areas/FraudDetection/Content/mailmaster.css")" rel="stylesheet" type="text/css" />
}
@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/MailMaster/mailmaster-add.js" type="text/javascript"></script>
}
