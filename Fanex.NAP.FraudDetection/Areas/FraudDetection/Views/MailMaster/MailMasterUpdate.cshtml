@using System.Web.Optimization
@model SPU.Lib.FraudDetection.Criteria.MailMaster.MailMasterUpdateCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Update Mail";
}
<h4>
    <b>Mail Master</b></h4>
<br>
@using (Html.BeginForm("UpdateMail", "MailMaster", FormMethod.Post, new { @id = "updateMailForm" }))
{
    <div class="col-md-12">
        <div class="form-group col-md-6">
            <label class="col-md-2">
                Mail Code</label>
            @Html.TextBoxFor(model => model.MailCode, new { @class = "col-md-8", @style = "width: 300px; margin-left: 3px; margin-right: 10px;" })
            @Html.ValidationMessageFor(model => model.MailCode)
        </div>
        <div class="form-group col-md-6">
            <label class="col-md-2">
                Description</label>
            @Html.TextBoxFor(model => model.MailDescription, new { @class = "col-md-6", @style = "width: 300px;"})
            <label class="col-md-2 text-right">
                Active</label>
            @Html.CheckBoxFor(model => model.IsActive) 
        </div>
    </div>
    <div class="col-md-12">
        <div class="form-group col-md-12">
            <label class="col-md-1">
                To</label>
            @Html.TextBoxFor(model => model.MailAddressSentTo, new { @class = "col-md-11" })
            @Html.ValidationMessageFor(model => model.MailAddressSentTo)
        </div>
        <div class="form-group col-md-12">
            <label class="col-md-1">
                CC</label>
            @Html.TextBoxFor(model => model.MailAddressCc, new { @class = "col-md-11" })
        </div>
        <div class="form-group col-md-12">
            <label class="col-md-1">
                BCC</label>
            @Html.TextBoxFor(model => model.MailAddressBcc, new { @class = "col-md-11" })
        </div>
        <div class="form-group col-md-12">
            <label class="col-md-1">
                Subject</label>
            @Html.TextBoxFor(model => model.MailSubject, new { @class = "col-md-11" })
            @Html.ValidationMessageFor(model => model.MailSubject)
        </div>
        <div>
            <div class="form-group col-md-1">
            </div>
            <div class="form-group col-md-9">
                @Html.TextAreaFor(model => model.MailContent, new { @class = "editor", @id = "editor", @style = "resize: none; height: 350px;" })
            </div>
            <div class="form-group col-md-2">
                <textarea cols="23" id="Message" name="Message" rows="25" style="resize: none;"></textarea>
            </div>
        </div>
    </div>
    <div class="form-group text-center col-md-12">
        <input type="submit" value="Submit" class="btn-green" />
    </div>
    @Html.HiddenFor(model => model.MailId)
}
<br />
@section FooterJs
{
    <script src="~/Areas/FraudDetection/Scripts/MailMaster/mailmaster-edit.js" type="text/javascript"></script>
}
