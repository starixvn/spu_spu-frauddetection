@model IList<Fanex.NAP.SPU.Model.DTO.DefaultBetSetting.SettingLogItem>
@if (Model.Count() > 0)
{
    foreach (var log in Model)
    {
    <tr>
        <td class="text-center">
            @log.LogDate.ToString("yyyy-MM-dd H:mm:ss tt")
        </td>
        <td>
            @log.EditedBy
        </td>
        <td>
            @log.ActionName
        </td>
        <td>
            <div class="table-title">
                @log.ActionName</div>
            @switch (log.ActionId)
            {
                case Fanex.NAP.SPU.Model.DataDomain.LogActionType.Delete:
                    Html.RenderPartial("~/Views/BetSetting/__DeleteLogItems.cshtml", log);
                    break;
                case Fanex.NAP.SPU.Model.DataDomain.LogActionType.Insert:
                    Html.RenderPartial("~/Views/BetSetting/__InsertLogItems.cshtml", log);

                    break;
                case Fanex.NAP.SPU.Model.DataDomain.LogActionType.Update:
                    Html.RenderPartial("~/Views/BetSetting/__UpdateLogItems.cshtml", log);
                    break;
            }
        </td>
    </tr>
    }
}
else
{
    <tr>
        <td colspan="4">
            <div class="no-info">
                There is no data</div>
        </td>
    </tr>
}