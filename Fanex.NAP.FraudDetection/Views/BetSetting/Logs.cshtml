@using System.Web.Optimization;
@{
    ViewBag.Title = "Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">View Log</li>
    </ul>
    <div class="pull-left">
        <a class="btn-back" href="default">← Back To List</a>
    </div>
}
<form role="form" action="/" class="form-inline col-sm-12 filter-form filter-logs">
<div class="row row-form">
    <div class="form-group">
        <label for="licensee" class="lbl">
            Licensee</label>
        <select id="licensee" class="width-160">
        </select>
    </div>
    <div class="form-group">
        <label for="currency" class="lbl">
            Currency</label>
        <select id="currency" class="width-160">
        </select>
    </div>
    <div class="form-group">
        <label for="agent" class="lbl">
            Agent</label>
        <select id="agent" class="width-160">
        </select>
    </div>
</div>
<div class="row row-form">
    <div class="form-group">
        <label for="from-date" class="lbl">
            From</label>
        <input type="text" id="from-date" value="@DateTime.Today.ToString("MM/dd/yyyy")"  class="width-160 text-box single-line valid">
    </div>
    <div class="form-group">
        <label for="to-date" class="lbl">
            To</label>
        <input type="text" id="to-date" value="@DateTime.Today.ToString("MM/dd/yyyy")"  class="width-160 text-box single-line valid">
    </div>
    <div class="form-group">
        <input type="button" id="generate" value="Generate" class="btn-generate">
    </div>
</div>
</form>
<table class="table table-bordered table-logs" id="table-content">
    <thead>
        <tr>
            <th class="width-100">
                Log Date
            </th>
            <th class="width-200">
                Edited By
            </th>
            <th class="width-200">
                Action
            </th>
            <th>
                Log Content <i id="table-toggle" class="icon-collapse-all"></i>
            </th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
@section FooterJs
{
    @Scripts.Render("~/bundles/DefaultBetSettingJs")

    <script type="text/javascript">
        $(document).ready(function () {
            viewLog.setup();
        });
    </script>
}