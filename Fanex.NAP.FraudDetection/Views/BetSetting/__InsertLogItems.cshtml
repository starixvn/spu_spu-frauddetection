@model Fanex.NAP.FraudDetection.Model.DTO.DefaultBetSetting.SettingLogItem
<table class="table table-bordered child-setting">
    <thead>
        <tr>
            <th>
                Sport/Game
            </th>
            <th>
                Max Bet
            </th>
            <th>
                Max Per Match
            </th>
            <th>
                Max Per Ball
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            var kenoGameType = (IDictionary<int, string>)ViewData[StaticSiteValue.KENOGAMETYPE];

        }
        @foreach (var setting in Model.Settings)
        {
            <tr>
                <td>
                    @setting.SportOrGame.Name
                    @if (setting.SportOrGame.Id == StaticSiteValue.KENOSPORT)
                    {
                        @Html.Raw("&nbsp;-&nbsp;")@kenoGameType[setting.BetType]
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxBet.HasValue)
                    {
                        @setting.MaxBet.Value
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxPerMatch.HasValue)
                    {
                        @setting.MaxPerMatch.Value
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxPerBall.HasValue)
                    {
                        @setting.MaxPerBall.Value
                    }
                </td>
            </tr>
        }
    </tbody>
</table>