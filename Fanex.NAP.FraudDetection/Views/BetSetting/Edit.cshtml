@using System.Web.Optimization;

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.NAP.SPU.Model.ViewModel.DefaultBetSetting.SingleDefaultBetSettingViewModel
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">Edit Default Bet Setting</li>
    </ul>
    <div class="pull-left">
        <a class="btn-back" href="default">← Back To List</a>
    </div>
}
@if (Model.HasSetting && Model.IsValid)
{
    <form role="form" action="#" class="form-inline col-sm-12 filter-form form-add-setting">
    <div class="form-group">
        <label for="licensee">
            Site</label>
        <select id="licensee" disabled="disabled" class="width-160">
            <option value="@Model.Licensee">@Model.Licensee</option>
        </select>
    </div>
    <div class="form-group">
        <label for="currency">
            Currency</label>
        <select id="currency" disabled="disabled" class="width-160">
            <option value="@Model.Currency.Id">@Model.Currency.Name</option>
        </select>
    </div>
    <div class="form-group">
        <label for="agent">
            Agent</label>
        <select id="agent" disabled="disabled" class="width-160">
            <option value="@(Model.Agent.Id.HasValue ? Model.Agent.Id.Value.ToString() : string.Empty)">
                @Model.Agent.Name
            </option>
        </select>
    </div>
    </form>
    <div class="col-sm-12">
        @{
    Html.RenderPartial("~/Views/BetSetting/_DefaultBetSettingList.cshtml", Model);
        }
    </div>
    <div class="col-sm-12">
        <button class="btn-primary" id="btn-submit">
            Submit</button>
        <button  class="btn-back">
            Back to List</button>
    </div>
}
else
{
    <div class="col-sm-12">
        No information is available
    </div>
}
@section FooterJs
{
    @Scripts.Render("~/bundles/DefaultBetSettingJs")

    <script type="text/javascript">
        $(document).ready(function () {
            editingSetting.setup();
        });
    </script>
}