@using Fanex.NAP.Core.Configuration
@using System.Web.Optimization;
<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8">
    <title>Fraud Detection</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    @Styles.Render("~/Content/Common/css", "~/Areas/FraudDetection/App_Themes/css", "~/Content/Core/less")
    @RenderSection("HeadCss", false)
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~/")';
        var SPU = {};
        SPU.getAbsoluteUrl = function (relativeUrl) {
            return window.rootUrl + relativeUrl;
        };
    </script>
</head>
<body ng-app="spu">
    <div class="container-fluid page">
        <header class="row header">
            <a class="logo" href="@Url.Action("Index","Home")">
                Fraud
                <span> Detection</span>
            </a>
            @Html.Action("Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
            <div class="user-info">
                <span class="info-bar">Howdy, <span class="account-name">@ViewBag.Session.Username</span><span class="caret"></span></span>
                <ul class="user-dropdown">
                    <li>@Html.ActionLink("Sign Out", "LogOut", "Login")</li>
                </ul>
            </div>
        </header>
        <section id="headline" class="row title-bar">
            @RenderSection("Headline", false)
        </section>
        <section id="body" class="row body">
            <div style="position: relative">
                <div id="sentAlert" class="col-md-offset-4 alert alert-danger collapse"
                     style="position: absolute; padding: 5px; top: -5px; left: 0; width: auto; min-width: 200px;">
                    <a href="#" class="close" data-dismiss="alert">&times;</a>
                    <div>Group for customers who violate many bets case</div>
                </div>
            </div>
            @RenderBody()
            <div id="loadingMsgBox" class="icon-loading hidden"></div>

        </section>
    </div>
    @RenderSection("Foot", false)
    @Scripts.Render("~/bundles/coreJs", "~/bundles/FraudDetectionJs")
    @if (NapSettings.Settings.EnableReCheckIn)
    {
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"> </script>
    }

</body>
@RenderSection("FooterJs", false)
</html>
