@using System.Web.Optimization;

<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @RenderSection("HeadCss", false)
    @Styles.Render("~/bundles/coreCss")
</head>
<body class="popup">
    <div style="position: relative">
        <div id="sentAlertOnPopup" class="alert alert-danger collapse" style="position: absolute;  padding: 5px; margin-bottom: 10px;width: 100%">
            <a href="#" class="close" data-dismiss="alert">&times;</a>
            <div></div>
        </div>
    </div>
@RenderBody()
</body>

@RenderSection("FooterJs",false)
</html>